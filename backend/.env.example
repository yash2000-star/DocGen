# ─── Required ──────────────────────────────────────────────────────────────
# Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key here (never the anon key, and never expose it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Where the frontend runs. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:5173

# ─── AI (needed to generate docs) ─────────────────────────────────────────
# Gemini API key from https://aistudio.google.com/apikey
# Powers the writer, the critic, search embeddings and Ask AI.
GEMINI_API_KEY=
# Optional model overrides
# GEMINI_WRITER_MODEL=gemini-3-flash-preview
# GEMINI_EDITOR_MODEL=gemini-2.5-flash-lite
# GEMINI_CHAT_MODEL=gemini-2.5-pro
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: run the writer on Vertex AI instead of a Gemini API key.
# Needs Google Cloud application default credentials (gcloud auth application-default login).
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_REGION=us-east5

# ─── Bring your own AI key ────────────────────────────────────────────────
# Master key that encrypts the AI provider keys users save in Settings → AI providers.
# Generate with: openssl rand -base64 32
# Keep it secret and keep a backup: if it changes, saved keys can't be decrypted
# and users must enter them again.
AI_KEY_ENCRYPTION_KEY=
# Let users point "Ollama" / "OpenAI-compatible" at localhost or private IPs.
# Defaults to true in development and false when NODE_ENV=production.
# ALLOW_PRIVATE_AI_ENDPOINTS=true

# Pages generated by the anonymous free preview (default 3)
# PREVIEW_MAX_PAGES=3

# ─── Optional: billing (Razorpay) ─────────────────────────────────────────
# Leave empty to run without billing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

# ─── Optional: email notifications (Gmail app password) ──────────────────
EMAIL_USER=
EMAIL_PASS=
