# ─── Required ──────────────────────────────────────────────────────────────
# Supabase project settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key here (never the anon key, and never expose it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Where the frontend runs. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:5173

# ─── AI: users bring their own keys ──────────────────────────────────────
# Users write docs and power Ask AI with their own AI provider keys, which they
# connect in Settings → AI providers. This master key encrypts those keys.
# Required for doc generation. Generate with: openssl rand -base64 32
# Keep it secret and keep a backup: if it changes, saved keys can't be decrypted
# and users must enter them again.
AI_KEY_ENCRYPTION_KEY=
# Let users point "Ollama" / "OpenAI-compatible" at localhost or private IPs.
# Defaults to true in development and false when NODE_ENV=production.
# ALLOW_PRIVATE_AI_ENDPOINTS=true
# Largest prompt sent to a model in one call (tokens). Bigger repos are summarized.
# AI_PROMPT_BUDGET_TOKENS=60000

# ─── Background jobs ──────────────────────────────────────────────────────
# Generations run as background jobs. The API server runs this many at once
# (default 2). Set 0 to run none in the API server and start separate workers
# with `npm run worker` instead (any number of them can share the queue).
# WORKER_CONCURRENCY=2
# A running job with no heartbeat for this long is retried by another worker (seconds).
# JOB_STALE_SECONDS=120
# First retry delay after a temporary failure (rate limit, provider outage); doubles each attempt.
# JOB_RETRY_BASE_SECONDS=30

# ─── Optional: anonymous free preview ────────────────────────────────────
# Visitors to /<owner>/<repo> can preview docs before signing up. They have no key,
# so the preview uses this server-paid AI credential. Leave empty to turn it off.
# Provider: anthropic, openai, gemini, openrouter, ollama or custom.
PREVIEW_AI_PROVIDER=
PREVIEW_AI_API_KEY=
# Only for ollama/custom:
# PREVIEW_AI_BASE_URL=
# Defaults to the provider's suggested models (required for openai/openrouter/ollama/custom):
# PREVIEW_AI_WRITER_MODEL=
# PREVIEW_AI_CRITIC_MODEL=
# Pages generated per preview (default 3)
# PREVIEW_MAX_PAGES=3

# Free previews per visitor per hour, and new previews per day for the whole server.
# PREVIEW_PER_VISITOR_PER_HOUR=5
# PREVIEW_DAILY_LIMIT=100

# ─── Security ──────────────────────────────────────────────────────────────
# Behind a load balancer or reverse proxy, set the number of proxy hops (usually 1) so
# rate limits see each visitor's real IP instead of the proxy's.
# TRUST_PROXY=1
# Let the docs "Try it" API playground call localhost and private networks.
# Defaults to true in development and false when NODE_ENV=production.
# API_PLAYGROUND_ALLOW_PRIVATE=false
# Push-to-update webhooks: each project has its own secret, shown in the project's
# Settings → Git settings. (The old shared GITHUB_WEBHOOK_SECRET is no longer used.)

# ─── Optional: billing (Razorpay) ─────────────────────────────────────────
# Leave empty to run without billing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

# ─── Optional: email notifications (Gmail app password) ──────────────────
EMAIL_USER=
EMAIL_PASS=
