# Supabase project settings → API (the anon/public key is safe in the browser;
# Row-Level Security in supabase/migrations protects the data)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the backend runs
VITE_API_URL=http://localhost:4000

# The app's own hostnames (comma-separated). On any other hostname the app shows the
# docs site whose custom domain it is.
# VITE_APP_HOSTNAMES=localhost,127.0.0.1,app.example.com
